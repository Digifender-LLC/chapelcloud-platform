{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed by Cloudflare Workers Builds on every merge to main (see AGENTS.md).
  // The name must match the Worker connected to Workers Builds.
  "name": "chapelcloud-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [{ "pattern": "api.chapel.cloud", "custom_domain": true }],
  "vars": {
    // Browser origin of the customer portal UI. Only this origin may make
    // credentialed cross-origin calls or state-changing requests.
    "PORTAL_ORIGIN": "https://portal.chapel.cloud"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chapelcloud-platform",
      "database_id": "ac299980-da6d-40bc-ba37-e7820ddaef47",
      "migrations_dir": "migrations"
    }
  ]
}
